<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lead tracker — {{ generated_at }}</title>
<style>
  :root {
    --bg: #fbfaf8; --panel: #fff; --ink: #1b1b1a; --muted: #6b6a67;
    --line: #e4e1db; --accent: #1c5d4a; --warn: #8a5a00; --bad: #96261d;
    --ok-bg: #e8f2ee; --warn-bg: #fbf1de; --bad-bg: #fbeae8; --unk-bg: #eeeded;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #16171a; --panel: #1e2024; --ink: #e9e8e5; --muted: #9a9894;
      --line: #303338; --accent: #6dc4a5; --warn: #e0aa5a; --bad: #e88178;
      --ok-bg: #1c302a; --warn-bg: #302818; --bad-bg: #331f1d; --unk-bg: #26282c;
    }
  }
  :root[data-theme="dark"] {
    --bg: #16171a; --panel: #1e2024; --ink: #e9e8e5; --muted: #9a9894;
    --line: #303338; --accent: #6dc4a5; --warn: #e0aa5a; --bad: #e88178;
    --ok-bg: #1c302a; --warn-bg: #302818; --bad-bg: #331f1d; --unk-bg: #26282c;
  }
  :root[data-theme="light"] {
    --bg: #fbfaf8; --panel: #fff; --ink: #1b1b1a; --muted: #6b6a67;
    --line: #e4e1db; --accent: #1c5d4a; --warn: #8a5a00; --bad: #96261d;
    --ok-bg: #e8f2ee; --warn-bg: #fbf1de; --bad-bg: #fbeae8; --unk-bg: #eeeded;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2rem 1.25rem 4rem; background: var(--bg); color: var(--ink);
    font: 15px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .wrap { max-width: 62rem; margin: 0 auto; }
  h1 { font-size: 1.5rem; margin: 0 0 .25rem; letter-spacing: -.01em; }
  .sub { color: var(--muted); font-size: .875rem; margin-bottom: 1.75rem; }
  .cards { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1.5rem; }
  .card {
    background: var(--panel); border: 1px solid var(--line); border-radius: 9px;
    padding: .6rem .85rem; min-width: 7rem;
  }
  .card .n { font-size: 1.35rem; font-weight: 600; font-variant-numeric: tabular-nums; }
  .card .k { color: var(--muted); font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; }
  .note {
    background: var(--panel); border: 1px solid var(--line); border-left: 3px solid var(--accent);
    border-radius: 7px; padding: .7rem .9rem; margin-bottom: 1.5rem;
    font-size: .85rem; color: var(--muted);
  }
  .lead {
    background: var(--panel); border: 1px solid var(--line); border-radius: 10px;
    padding: 1rem 1.1rem; margin-bottom: .9rem;
  }
  .lead h2 { font-size: 1.02rem; margin: 0 0 .15rem; }
  .lead h2 a { color: inherit; }
  .meta { color: var(--muted); font-size: .78rem; margin-bottom: .7rem; }
  .score { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .6rem; }
  .pill {
    font-size: .74rem; padding: .16rem .5rem; border-radius: 999px;
    border: 1px solid var(--line); background: var(--unk-bg); white-space: nowrap;
  }
  .pill.ok { background: var(--ok-bg); color: var(--accent); border-color: transparent; }
  .pill.warn { background: var(--warn-bg); color: var(--warn); border-color: transparent; }
  .pill.bad { background: var(--bad-bg); color: var(--bad); border-color: transparent; }
  .veto {
    background: var(--bad-bg); color: var(--bad); border-radius: 6px;
    padding: .4rem .6rem; font-size: .82rem; margin: .3rem 0;
  }
  ul.reasons { margin: .4rem 0 .6rem; padding-left: 1.1rem; font-size: .86rem; }
  ul.reasons li { margin-bottom: .12rem; }
  details { margin-top: .5rem; }
  summary {
    cursor: pointer; font-size: .8rem; color: var(--muted);
    padding: .2rem 0; user-select: none;
  }
  .tablewrap { overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; font-size: .8rem; margin-top: .5rem; }
  th, td { text-align: left; padding: .3rem .5rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--muted); font-weight: 500; }
  code { font: .78rem ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--muted); }
  pre {
    background: var(--bg); border: 1px solid var(--line); border-radius: 7px;
    padding: .7rem .85rem; overflow-x: auto; font-size: .8rem; white-space: pre-wrap;
  }
  a { color: var(--accent); }
  .empty { color: var(--muted); font-style: italic; padding: 2rem 0; }
</style>
</head>
<body>
<div class="wrap">
  <h1>Lead tracker</h1>
  <div class="sub">Generated {{ generated_at }} · {{ total }} leads tracked</div>

  <div class="cards">
    {% for stage, n in stage_counts %}
      <div class="card"><div class="n">{{ n }}</div><div class="k">{{ stage }}</div></div>
    {% endfor %}
  </div>

  <div class="note">
    Business names, addresses and phone numbers are <strong>not stored</strong> — Google's terms
    forbid it. Each lead links out to Google Maps by place ID, where the current details live.
    {% if usage %}<br>API usage this month: {% for sku, n in usage %}<code>{{ sku }}</code> {{ n }}{% if not loop.last %} · {% endif %}{% endfor %}{% endif %}
  </div>

  {% if not leads %}
    <p class="empty">No scored leads yet. Run <code>python -m leadgen discover</code>, then
    <code>verify</code>, then <code>score</code>.</p>
  {% endif %}

  {% for item in leads %}
  {% set lead = item.lead %}{% set s = lead.score %}
  <div class="lead">
    <h2><a href="{{ item.maps_url }}" target="_blank" rel="noopener">{{ item.label }}</a></h2>
    <div class="meta">
      {{ lead.city }} · {{ lead.category_probe }} · stage <strong>{{ lead.stage.value }}</strong>
      · <code>{{ lead.place_id }}</code>
    </div>

    {% if s %}
    <div class="score">
      <span class="pill {{ 'ok' if item.qualified else 'bad' }}">
        {{ 'qualified' if item.qualified else 'not qualified' }} · {{ '%.2f'|format(s.total) }}
      </span>
      <span class="pill {{ 'ok' if s.needs_customers >= 0.5 else 'warn' }}">needs customers {{ '%.2f'|format(s.needs_customers) }}</span>
      <span class="pill {{ 'ok' if s.will_spend >= 0.5 else 'warn' }}">will spend {{ '%.2f'|format(s.will_spend) }}</span>
      <span class="pill {{ 'ok' if s.will_engage >= 0.5 else 'warn' }}">will engage {{ '%.2f'|format(s.will_engage) }}</span>
      <span class="pill">{{ s.axes_passed }}/3 axes</span>
    </div>

    {% for d in s.disqualifiers %}<div class="veto">Veto — {{ d }}</div>{% endfor %}

    {% if s.reasons %}
    <ul class="reasons">{% for r in s.reasons %}<li>{{ r }}</li>{% endfor %}</ul>
    {% endif %}
    {% endif %}

    {% if item.checks %}
    <details>
      <summary>Manual checks still open ({{ item.checks|length }})</summary>
      <ul class="reasons">
        {% for c in item.checks %}
        <li><a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.label }}</a> — {{ c.note }}</li>
        {% endfor %}
      </ul>
    </details>
    {% endif %}

    <details>
      <summary>Evidence trail ({{ item.observations|length }} observations)</summary>
      <div class="tablewrap">
      <table>
        <tr><th>field</th><th>value</th><th>confidence</th><th>source</th><th>method</th><th>observed</th></tr>
        {% for key, o in item.observations %}
        <tr>
          <td><code>{{ key }}</code></td>
          <td>{{ o.value if o.value is not none else '—' }}</td>
          <td>{{ o.confidence.value }}</td>
          <td>{{ o.source.value }}</td>
          <td>{{ o.method }}{% if o.note %} <em>({{ o.note }})</em>{% endif %}</td>
          <td>{{ o.observed_at.strftime('%Y-%m-%d') }}</td>
        </tr>
        {% endfor %}
      </table>
      </div>
    </details>

    {% for o in lead.outreach %}
    <details>
      <summary>Draft — {{ o.channel }}{% if o.subject %}: {{ o.subject }}{% endif %}
        {% if not o.approved_by_operator %}(unapproved){% endif %}</summary>
      <pre>{{ o.body }}</pre>
    </details>
    {% endfor %}
  </div>
  {% endfor %}
</div>
</body>
</html>
