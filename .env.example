# Copy to .env and fill in. .env is gitignored — never commit real values.

# Google Places API (New). Create at https://console.cloud.google.com/
# Restrict the key to the Places API before using it.
GOOGLE_MAPS_API_KEY=

# These appear verbatim in messages to strangers, so nothing is guessed for you.
# Use a personal-name domain, not a Gmail address — you are selling web presence.
OPERATOR_NAME=
OPERATOR_SITE=
OPERATOR_EMAIL=

# Optional. A second number for inbound only — never make cold calls from it.
OPERATOR_PHONE=
OPERATOR_CITY=Bangalore

# Optional
LEADGEN_DB=leads.db
